  "light_contrast": {
    "eny": {
      "technique": "\"chip_or_accent\"",
      "forbidden": "\"plain_text\"",
      "accent_color": "hsl(67, 67%, 59%)",
      "chip_bg": "#111"
    },
    "agent": {
      "technique": "chip_or_accent",
