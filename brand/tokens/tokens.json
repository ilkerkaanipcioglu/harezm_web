      "ipcioglu": "\"/assets/icons/ipcioglu/\"",
      "harezm": "\"/assets/icons/harezm/\"",
      "eny": "\"/assets/icons/eny/\"",
      "agent": "\"/assets/icons/agent/\"",
      "shared": "\"/assets/icons/shared/\""
    }
  },
  "spacing": {
    "base": 4
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "pill": 9999
  },
