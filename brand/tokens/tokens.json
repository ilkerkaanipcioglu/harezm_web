      "min_size": "24px",
      "clearspace": "8px"
    }
  },
  "icons": {
    "source_dir": "/assets/icons/",
    "format": "svg",
    "color_mode": "\"currentColor\"",
    "naming": "\"{brand}-{name}\"",
