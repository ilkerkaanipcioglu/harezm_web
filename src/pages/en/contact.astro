---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { t } from '../../i18n/utils';

const lang = 'en' as const;
---
<Layout title="Contact | Harezm" description="Contact Harezm Technology. Reach out for SAP projects, financial technology solutions, and global consulting services." lang={lang}>
    <section class="pt-40 pb-32 px-8 bg-surface text-center">
        <div class="max-w-container mx-auto flex flex-col items-center">
            <span class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary font-bold text-xs tracking-widest uppercase mb-6">CONTACT US</span>
            <h1 class="display-lg text-5xl md:text-6xl font-bold font-headline mb-6 text-on-background">Let's Evaluate the Right Approach Together.</h1>
            <p class="text-xl text-on-surface-variant mb-16 leading-relaxed max-w-4xl mx-auto">
                Let's plan the most accurate financial transformation strategy for you. Get in direct touch with our executives for your corporate SAP and AI-supported infrastructure goals.
            </p>
            
            <!-- Contact Form -->
            <div class="w-full max-w-5xl mx-auto mb-24 text-left">
                <div class="bg-surface-container-low p-8 md:p-12 rounded-3xl border border-outline-variant/30 shadow-xl relative overflow-hidden">
                    <div id="form-success" class="hidden text-center py-12">
                        <div class="w-20 h-20 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-6">
                            <span class="material-symbols-outlined text-4xl">check_circle</span>
                        </div>
                        <h3 class="text-2xl font-bold font-headline mb-4">Message Sent!</h3>
                        <p class="text-on-surface-variant mb-8">We will get back to you as soon as possible.</p>
                        <button onclick="window.location.reload()" class="text-primary font-bold hover:underline">Send a new message</button>
                    </div>

                    <form id="contact-form" class="space-y-6">
                        <input type="hidden" name="domain" value="harezm.com" />
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label for="name" class="text-xs font-bold text-primary uppercase tracking-widest">{t('contactFormName', lang)}</label>
                                <input type="text" id="name" name="name" required class="w-full bg-surface border border-outline-variant/30 rounded-xl px-4 py-4 focus:border-primary outline-none transition-all" placeholder={t('contactFormNamePh', lang)} data-fs-field />
                            </div>
                            <div class="space-y-2">
                                <label for="company" class="text-xs font-bold text-primary uppercase tracking-widest">{t('contactFormCompany', lang)}</label>
                                <input type="text" id="company" name="company" required class="w-full bg-surface border border-outline-variant/30 rounded-xl px-4 py-4 focus:border-primary outline-none transition-all" placeholder={t('contactFormCompanyPh', lang)} data-fs-field />
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label for="email" class="text-xs font-bold text-primary uppercase tracking-widest">{t('contactFormEmail', lang)}</label>
                                <input type="email" id="email" name="email" required class="w-full bg-surface border border-outline-variant/30 rounded-xl px-4 py-4 focus:border-primary outline-none transition-all" placeholder={t('contactFormEmailPh', lang)} data-fs-field />
                            </div>
                            <div class="space-y-2">
                                <label for="projectType" class="text-xs font-bold text-primary uppercase tracking-widest">{t('contactFormType', lang)}</label>
                                <select id="projectType" name="projectType" required class="w-full bg-surface border border-outline-variant/30 rounded-xl px-4 py-4 focus:border-primary outline-none transition-all data-fs-field">
                                    <option value="">Select...</option>
                                    <option value={t('contactFormOpt1', lang)}>{t('contactFormOpt1', lang)}</option>
                                    <option value={t('contactFormOpt2', lang)}>{t('contactFormOpt2', lang)}</option>
                                    <option value={t('contactFormOpt3', lang)}>{t('contactFormOpt3', lang)}</option>
                                    <option value={t('contactFormOpt4', lang)}>{t('contactFormOpt4', lang)}</option>
                                </select>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label for="message" class="text-xs font-bold text-primary uppercase tracking-widest">{t('contactFormMsg', lang)}</label>
                            <textarea id="message" name="message" required rows="5" class="w-full bg-surface border border-outline-variant/30 rounded-xl px-4 py-4 focus:border-primary outline-none transition-all resize-none" placeholder={t('contactFormMsgPh', lang)} data-fs-field></textarea>
                        </div>

                        <div id="form-error" class="hidden p-4 rounded-xl bg-error/10 border border-error/20 text-error text-sm text-center" data-fs-error>
                            An error occurred, please try again.
                        </div>

                        <button type="submit" id="submit-btn" class="w-full bg-primary text-on-primary py-5 rounded-xl font-bold hover:brightness-110 transition-all flex items-center justify-center gap-3 group disabled:opacity-50" data-fs-submit-btn>
                            <span>{t('contactFormSubmit', lang)}</span>
                            <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">send</span>
                        </button>
                    </form>
                </div>
            </div>

            <div class="w-full border-t border-outline-variant/20 pt-16 mb-12 text-center">
                <h2 class="text-2xl font-bold font-headline mb-2 text-on-background">Alternative Contact Channels</h2>
                <p class="text-on-surface-variant font-light">If you prefer not to fill out the form, you can reach us directly.</p>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 w-full">
                <!-- WhatsApp -->
                <a href="https://wa.me/905332388975" target="_blank" rel="noopener noreferrer" class="bg-surface-container-low p-10 rounded-3xl border border-outline-variant/30 hover:border-primary/50 hover:-translate-y-2 hover:shadow-xl transition-all group flex flex-col items-center justify-center text-center">
                    <div class="w-16 h-16 rounded-2xl bg-primary/10 text-primary mb-6 flex justify-center items-center group-hover:bg-[#25D366] group-hover:text-white transition-colors">
                        <Icon name="icon_08_chat_message" size={32} animate />
                    </div>
                    <h3 class="text-2xl font-bold font-headline text-on-background mb-3">WhatsApp</h3>
                    <p class="text-on-surface-variant text-sm font-medium tracking-wide group-hover:text-primary transition-colors">Send Message &rarr;</p>
                </a>
                
                <!-- Telegram -->
                <a href="https://t.me/+905332388975" target="_blank" rel="noopener noreferrer" class="bg-surface-container-low p-10 rounded-3xl border border-outline-variant/30 hover:border-primary/50 hover:-translate-y-2 hover:shadow-xl transition-all group flex flex-col items-center justify-center text-center">
                    <div class="w-16 h-16 rounded-2xl bg-primary/10 text-primary mb-6 flex justify-center items-center group-hover:bg-[#26A5E4] group-hover:text-white transition-colors">
                        <Icon name="icon_17_share" size={32} animate />
                    </div>
                    <h3 class="text-2xl font-bold font-headline text-on-background mb-3">Telegram</h3>
                    <p class="text-on-surface-variant text-sm font-medium tracking-wide group-hover:text-primary transition-colors">Text & Audio &rarr;</p>
                </a>

                <!-- LinkedIn -->
                <a href="https://www.linkedin.com/in/ilkerkaan/" target="_blank" rel="noopener noreferrer" class="bg-surface-container-low p-10 rounded-3xl border border-outline-variant/30 hover:border-[#0077b5]/50 hover:-translate-y-2 hover:shadow-xl transition-all group flex flex-col items-center justify-center text-center">
                    <div class="w-16 h-16 rounded-2xl bg-primary/10 text-primary mb-6 flex justify-center items-center group-hover:bg-[#0077b5] group-hover:text-white transition-colors">
                        <Icon name="icon_17_share" size={32} class="rotate-[-45deg]" />
                    </div>
                    <h3 class="text-2xl font-bold font-headline text-on-background mb-3">LinkedIn DM</h3>
                    <p class="text-on-surface-variant text-sm font-medium tracking-wide group-hover:text-primary transition-colors">Send a Message &rarr;</p>
                </a>
                
                <!-- Email -->
                <a href="mailto:info@harezm.com" class="bg-surface-container-low p-10 rounded-3xl border border-outline-variant/30 hover:border-primary/50 hover:-translate-y-2 hover:shadow-xl transition-all group flex flex-col items-center justify-center text-center">
                    <div class="w-16 h-16 rounded-2xl bg-primary/10 text-primary mb-6 flex justify-center items-center group-hover:bg-primary group-hover:text-white transition-colors">
                        <Icon name="icon_08_chat_message" size={32} animate />
                    </div>
                    <h3 class="text-2xl font-bold font-headline text-on-background mb-3">Email</h3>
                    <p class="text-on-surface-variant text-sm font-medium tracking-wide group-hover:text-primary transition-colors">Official Inquiries &rarr;</p>
                </a>
            </div>
            
            <div class="mt-20 max-w-4xl mx-auto opacity-70 border-t border-outline-variant/20 pt-10">
                <p class="text-sm text-on-surface-variant italic mb-4">"Your messages are routed directly to our technical architects. Instead of a classic call center queue, you swiftly reach the right solution expert."</p>
            </div>
        </div>
    </section>
    <script is:inline>
      const setupForm = () => {
        const form = document.querySelector('#contact-form');
        const successDiv = document.querySelector('#form-success');
        const errorDiv = document.querySelector('#form-error');
        const submitBtn = document.querySelector('#submit-btn');

        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                if (submitBtn) submitBtn.disabled = true;
                if (errorDiv) errorDiv.classList.add('hidden');

                const formData = new FormData(form);
                const data = {};
                formData.forEach((value, key) => {
                    data[key] = value;
                });

                try {
                    const response = await fetch('https://cloud.activepieces.com/api/v1/webhooks/2UNdS2U2oQRd5PaLtgINz', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(data)
                    });

                    if (response.ok) {
                        form.classList.add('hidden');
                        successDiv.classList.remove('hidden');
                    } else {
                        throw new Error('Form submission failed');
                    }
                } catch (error) {
                    console.error('Error submitting form:', error);
                    if (errorDiv) errorDiv.classList.remove('hidden');
                } finally {
                    if (submitBtn) submitBtn.disabled = false;
                }
            });
        }
      };

      document.addEventListener('astro:page-load', setupForm);
      setupForm();
    </script>
</Layout>
