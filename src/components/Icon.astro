const defaultIcon = {
  viewBox: '0 0 24 24',
  path: `<circle cx="12" cy="12" r="10" stroke-width="2" />`
};

const resolvedIcon = iconMap[name] || iconMap[name.replace('_gear', '').replace('_arrow', '')] || defaultIcon;
---

<div 
  class={`icon-container ${animate ? 'animate-wobble' : ''} ${className}`}
  style={`width: ${numericSize}px; height: ${numericSize}px;`}
>
  <svg 
    viewBox={resolvedIcon.viewBox} 
    fill="none" 
    stroke="currentColor"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full"
    set:html={resolvedIcon.path}
  />
</div>

<style>
  .icon-container {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: currentColor;
    transition: transform 0.3s ease;
  }

  /* Signature Wobble Animation */
  .animate-wobble:hover {
    animation: wobble 0.5s ease-in-out infinite alternate;
  }

  @keyframes wobble {
    0% { transform: rotate(-3deg) scale(1); }
    100% { transform: rotate(3deg) scale(1.05); }
  }
</style>
